# iLovePDF MCP server — environment variables
# Copy this file to .env and fill in your values.
# See README.md for full documentation.

# Required (per-call): your iLovePDF public API key.
# Obtain one at https://developer.ilovepdf.com/
# The server starts without this, but every tool call fails until it is set.
ILOVEPDF_PUBLIC_KEY=

# Optional: primary working directory for file inputs and outputs.
# Defaults to the process working directory (cwd) when not set.
# The server creates this directory automatically if it does not exist.
ILOVEPDF_MCP_WORKDIR=

# Optional: additional allowlisted directories, separated by the OS path delimiter
# (colon ':' on Unix/macOS, semicolon ';' on Windows).
# Non-existent entries are ignored with a warning at startup.
# Example (Unix):   /home/user/downloads:/tmp/pdf-work
# Example (Windows): C:\Users\you\Downloads;D:\pdf-work
ILOVEPDF_MCP_ALLOWED_DIRS=
